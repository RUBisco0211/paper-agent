# 该文件只是示例，复制为 .env 后按需替换；所有秘密都必须显式配置。

# --- 应用 ---
ENVIRONMENT=development
API_PREFIX=/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- 数据库 ---
# 密码要与仓库根 .env 的 POSTGRES_PASSWORD（compose 用）保持一致
DATABASE_URL=postgresql+psycopg://paper_agent:paper_agent_dev@127.0.0.1:5432/paper_agent
TEST_DATABASE_URL=postgresql+psycopg://paper_agent:paper_agent_dev@127.0.0.1:5432/paper_agent_test
DATABASE_ECHO=false

# --- 日志 ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- 对象存储（PDF、MinerU 产物、会话 Entry 日志）---
STORAGE_ROOT=.var/storage

# --- 上传限制 ---
MAX_PDF_BYTES=52428800
MAX_PDF_PAGES=300

# --- 认证 ---
# 登录令牌签名密钥：部署前用 `openssl rand -hex 32` 生成，只写进 backend/.env
# 占位符或短于 32 字符会在启动时报错（生产环境下直接拒绝启动）
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32
# 两服务共用的内部检索密钥：用 `openssl rand -hex 32` 生成，勿提供给浏览器
AGENT_INTERNAL_KEY=
BUSINESS_API_URL=http://127.0.0.1:8000
AGENT_SERVICE_URL=http://127.0.0.1:8001
SCHEDULE_DEFAULT_TIMEZONE=Asia/Shanghai
# Credential 主密钥：32 随机字节的 hex；首次生成后需安全备份，丢失无法恢复已存 Key
CREDENTIAL_MASTER_KEY=
# 可选：服务端为某个 Provider 指定受信任 endpoint，JSON 映射；浏览器仍不可自由输入
CREDENTIAL_BASE_URLS={}
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=paper_agent_refresh
REFRESH_COOKIE_SECURE=false

# --- 邮箱验证与任务通知 ---
# Compose Redis 使用标准 6379；本机不得再运行第二个 Redis。
REDIS_URL=redis://127.0.0.1:6379/0
# 浏览器可访问的站点根地址；生产使用 HTTPS，用于邮件里的运行记录链接。
PUBLIC_APP_URL=http://localhost:5173
# SMTP 凭据只写进 backend/.env，不提交；QQ 邮箱使用独立授权码而非登录密码。
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Paper Agent
SMTP_USE_SSL=true
SMTP_STARTTLS=false

# --- 实例级 Provider（不填则对应能力保持未配置）---
# MinerU 官方远程 API（/api/v4），URL 只填 base URL。
MINERU_API_URL=https://mineru.net
MINERU_API_KEY=
MINERU_TIMEOUT_SECONDS=600

# 入库流水线：下载、解析、切块、向量化各有一个并发上限。
# 同一论文的三个阶段按产物依赖串行；并发生在不同论文之间。
# 下载没有公开速率标准，8 是经验值；arXiv 官方要求每 3 秒一次，当前未单独约束。
DOWNLOAD_CONCURRENCY=8
# MinerU 单账号允许 10+ 个并发任务
PARSE_CONCURRENCY=8
# 纯本机计算，留空或 0 表示按 CPU 核数自动取
CHUNK_CONCURRENCY=0
# 受供应商 TPM 约束，令牌桶会再压一道
EMBED_CONCURRENCY=2
# 某阶段连续失败几次后判死，以及指数退避的基数与上限（秒）
STAGE_MAX_ATTEMPTS=3
STAGE_RETRY_BASE_SECONDS=60
STAGE_RETRY_MAX_SECONDS=300
# Embedding：任何 OpenAI 兼容的 /embeddings 服务（远程）。当前用硅基流动的 BAAI/bge-m3：
#   1024 维、多语言、无需 query/document 前缀，批大小与截断走模型档案默认值。
# 换模型就换了向量空间，同维度的旧向量也不能混用，必须整库重算。
EMBEDDING_API_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
# 必须与 alembic 迁移里 chunks.embedding 的维度一致；改维度需要离线迁移
EMBEDDING_DIMENSIONS=1024
# 适配层：目前只有 openai_compatible（覆盖 OpenAI/TEI/Ollama/vLLM 等 /embeddings 服务）
EMBEDDING_ADAPTER=openai_compatible
# 以下留空即使用模型档案默认值（见 app/embedding/profiles.py）：
# 输入截断长度、query/document 前缀（e5、nomic、embeddinggemma 这类模型必须填）
EMBEDDING_MAX_INPUT_CHARS=
EMBEDDING_MAX_BATCH_ITEMS=
EMBEDDING_MAX_BATCH_CHARS=
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BACKOFF_SECONDS=1
# 供应商按分钟计的额度，令牌桶据此在本地排队，避免把请求打成 429。
# 默认取硅基流动 bge-m3 的公开额度；自建 TEI 等不限速服务填 0 即可关闭。
EMBEDDING_RPM=2000
EMBEDDING_TPM=500000
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=
CROSSREF_API_URL=https://api.crossref.org
# 匿名请求可能触发共享出口限流；建议配置免费的 OpenAlex API Key。
OPENALEX_API_KEY=
ARXIV_API_URL=https://export.arxiv.org/api/query
ZOTERO_RECOGNIZER_URL=

# --- 问答模型目录 ---
# 用户只能从这些 AgentScope 原生 Provider 及其 Model Card 中选择，并自行填写 API Key。
LLM_PROVIDERS=["openai","anthropic","dashscope","deepseek","moonshot","xai"]

# --- 会话与事件流 ---
SESSION_EVENT_BUFFER_SIZE=500
SSE_IDLE_TIMEOUT_SECONDS=60

# --- 检索与分块 ---
KEYWORD_TOP_N=20
VECTOR_TOP_N=20
RRF_K=60
MAX_EVIDENCE_CHUNKS=12
MAX_EVIDENCE_PER_PAPER=4
CHUNK_TOKEN_NUM=512
CHUNK_MAX_CHARS=4000

# Object storage for PDFs, MinerU artifacts and session entry logs.
#   local  -> STORAGE_ROOT (default .var/storage), development/testing only
#   s3     -> any S3-compatible service (RustFS, Garage, Aliyun OSS, Cloudflare R2 ...)
# Production rejects local storage and fails startup if S3 is unavailable.
# Starting the bundled RustFS container: docker compose --profile storage up -d storage
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=paper-agent
S3_REGION=us-east-1
# 自建服务通常只支持 path-style（bucket 放在路径里）
S3_ADDRESSING_STYLE=path
