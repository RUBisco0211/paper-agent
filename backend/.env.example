# 该文件只是示例，复制为 .env 后按需替换；所有秘密都必须显式配置。

# --- 应用 ---
ENVIRONMENT=development
API_PREFIX=/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- 数据库 ---
DATABASE_URL=postgresql+psycopg://paper_agent:change-me@127.0.0.1:5432/paper_agent
TEST_DATABASE_URL=postgresql+psycopg://paper_agent:change-me@127.0.0.1:5432/paper_agent_test
DATABASE_ECHO=false

# --- 日志 ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- 对象存储（PDF、MinerU 产物、会话 Entry 日志）---
STORAGE_ROOT=.var/storage

# --- 上传限制 ---
MAX_PDF_BYTES=52428800
MAX_PDF_PAGES=300

# --- 认证 ---
JWT_SECRET_KEY=change-me-please-set-a-real-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=paper_agent_refresh
REFRESH_COOKIE_SECURE=false

# --- 实例级 Provider（不填则对应能力保持未配置）---
MINERU_API_URL=
MINERU_API_KEY=
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CROSSREF_API_URL=https://api.crossref.org
ARXIV_API_URL=https://export.arxiv.org/api/query
ZOTERO_RECOGNIZER_URL=

# 允许用户选择的 LLM Provider 及其固定 Base URL（JSON 对象）
LLM_PROVIDERS={"openai":"https://api.openai.com/v1","deepseek":"https://api.deepseek.com/v1"}

# --- 会话与事件流 ---
SESSION_EVENT_BUFFER_SIZE=500
SSE_IDLE_TIMEOUT_SECONDS=60

# --- 检索与分块 ---
KEYWORD_TOP_N=20
VECTOR_TOP_N=20
RRF_K=60
MAX_EVIDENCE_CHUNKS=12
MAX_EVIDENCE_PER_PAPER=4
CHUNK_TOKEN_NUM=512
CHUNK_MAX_CHARS=4000
