# docker compose 使用的变量（复制为 .env 后生效）

# 拉取模型权重的 HuggingFace 端点。
# 直连 huggingface.co 不通时改成镜像：https://hf-mirror.com
HF_ENDPOINT=https://huggingface.co

# TEI 镜像：按硬件选择（详见 docker-compose.yml 注释）
#   Apple Silicon  ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-1.9
#   x86 纯 CPU     ghcr.io/huggingface/text-embeddings-inference:cpu-1.9
#   NVIDIA A100    ghcr.io/huggingface/text-embeddings-inference:1.9
#   NVIDIA H100    ghcr.io/huggingface/text-embeddings-inference:hopper-1.9
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-1.9

# 向量模型（需与 backend/.env 的 EMBEDDING_MODEL 一致）
EMBEDDING_MODEL=BAAI/bge-m3
